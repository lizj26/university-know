# ---- 生成物（删掉不会损坏项目，跑一次 refresh.py / fetch_campus.py 就能重建）----
# 注意：index.html 与 _work/registry-*.json **需要提交**——
# GitHub Pages 直接发布仓库里的 index.html（无构建步骤），
# registry 记录来源状态历史，提交后 GitHub Actions 每轮才能延续状态。
data/*.bak
build/reports/
_work/items-*.json
_work/run.log

# ---- 敏感凭据：绝对不要提交 ----
_work/wechat/wxmp-cookie-header*.txt
_work/wechat/wxmp-cookies*.json
_work/wechat/wxmp-token*.txt
_work/wechat/wxmp-wap-cookies*.txt
# 号池：每个 .txt 都是一份账号凭据，等同密码
_work/wechat/wxmp-pool/
_work/wechat/.cache/
# 扫码会话目录（含 cookies.json / session.json，等同密码）
_work/wxmp-spider*/
# 搜狗抓下来的正文
_work/wechat/sogou-md/

# ---- 打包产物 ----
deploy/serverless/dist/
deploy/edgeone/dist/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---- 本地助手工作区（个人记忆与配置，不进公开仓库）----
.workbuddy/

# ---- 临时整理目录（手动上传用的中转文件夹）----
_upload_fix/
_upload_scripts/
_forcopy/
_bak_*/
_artifacts/
# 对标站点的一次性拆解产物（第三方页面/接口快照，不入库）
_work/pkuknow/
_work/pkucli-ref/
_work/wechat/history-seen-*.json
# 旧备份的归档（tar.gz 里是历史快照，留档用，不进版本库）
_work/_archive/

# ---- 公开合集链路（albums/）的产物 ----
# state.json **不提交**：它是增量水位（每集抓到哪个 msgid），带 last_run 时间戳，
#   每轮都变 —— 入库就是每天 3 个纯噪声提交。云端改用 actions/cache 跨轮延续
#   （见 .github/workflows/update.yml），缓存丢了只是退回一次全量翻页。
# albums-*.json 是抓取产物（每轮都变、近 600KB），`python -m albums fetch` 一分钟就能重建。
# discovered-*.json **要提交**：那是搜狗开页挖出来的合集线索，重挖要几十次 3.5MB 请求。
# site-*.json 是 export 的纯派生结果，能随时重算。
_work/albums/state.json
_work/albums/site-*.json
_work/albums/albums-*.json

# ---- 公开链接链路（links/）的台账 ----
# 全部可从公开渠道重建（几十分钟），上千条 URL 没必要入库；要留档用 report --csv。
_work/links/
